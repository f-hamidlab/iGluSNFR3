
% roiList = [3, 30, 31, 35, 44, 53, 56, 57, 59, 60, 62, 66, 67, 73, 75, 76, 88, 93] ;
ops.savedir = '../../originals/260331 B Cell 4 part 1/outputs/Cell4_1/';

%% Continuous wavelet transform
load(fullfile(ops.savedir,"processed_data.mat"))
roiList = 1:length(ROI);

ops.savedir_ROIcwt = fullfile(ops.savedir,'ROI_cwt');
if ~exist(ops.savedir_ROIcwt, 'dir')
    mkdir(ops.savedir_ROIcwt)
end
%% 

for i = 1:numel(event_cluster)
    roi = roiList(i);
    pxList = ROI(roi).PixelIdxList;
    yData = mean(signal_dfof(:,ismember(ind, pxList)),2);

    tiledlayout(4,1)
    nexttile    
    plot(ops.t, yData)
    hold on
    dff_t = event_cluster(find([event_cluster.ROI]==roi)).dff_t;
    scatter(dff_t/ops.fs, yData(dff_t))
    xlabel('Time(s)')
    ylabel('mean ΔF/F')
    title(sprintf('ROI: %03d',roi))

    ax1 = nexttile([3 1]);
    cwt(yData, ops.fs, Parent=ax1);

    % save figure
    fig_name = sprintf('ROI%03d_CWT',roi);
    save_figure(gcf, fig_name, ops.savedir_ROIcwt, ops.fig_format, 1);
end

%% Intensity check

ops.savedir_ROI_intensity = fullfile(ops.savedir,'ROI_intensity');
if ~exist(ops.savedir_ROI_intensity, 'dir')
    mkdir(ops.savedir_ROI_intensity)
end

for i = 1:numel(roiList)
    roi = roiList(i);
    pxList = ROI(roi).PixelIdxList;

    tiledlayout(3,1)
    nexttile
    yData = mean(signal_raw(:,ismember(ind, pxList)),2);
    plot(ops.t, yData)
    xlabel('Time(s)')
    ylabel('F')
    
    nexttile
    yData = mean(signal_df(:,ismember(ind, pxList)),2);
    plot(ops.t, yData)
    xlabel('Time(s)')
    ylabel('mean ΔF')

    nexttile
    yData = mean(signal_dfof(:,ismember(ind, pxList)),2);
    plot(ops.t, yData)
    xlabel('Time(s)')
    ylabel('mean ΔF/F')

    % save figure
    fig_name = sprintf('ROI%03d_Intensity',roi);
    save_figure(gcf, fig_name, ops.savedir_ROI_intensity, ops.fig_format, 1);
end

%%
function save_figure(fig_handle, fig_name, savedir, fig_format, close_fig, fig_position)
    if nargin<6
        % set to full screen
        set(fig_handle, 'Position', get(0, 'Screensize'));
    else
        set(fig_handle,'Position',fig_position);
    end

    set(fig_handle,'Units','normalized','Position',[0 0 1 1]); % [0 0 width height]
    saveas(gcf, fullfile(savedir, [fig_name,'.fig']))
    saveas(gcf, fullfile(savedir, [fig_name, fig_format]))
    if close_fig
        close(gcf)
    end
end